      "listBottomInset": 132,
      "cardTextX": 8,
      "cardTextY": 4,
      "cardTextInsetX": 16,
      "cardMetaHeight": 22,
      "cardMetaBottomGap": 16,
      "cardLineHeight": 18,
      "cardMaxLines": 3,
      "emptyTextInsetX": 24,
      "footerMarginX": 12,
      "footerBottomGap": 10,
