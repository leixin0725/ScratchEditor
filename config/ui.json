  // ===== 深浅主题基础调色板 =====
  // 强调色（accentColor / accentTextColor）仍由 config/markdown-style.json
  // 统一提供，本文件不重复定义。
  "palette": {
    "dark": {
      "background": "#252525",
      "editorSurface": "#292929",
      "panel": "#292929",
      "field": "#1d1d1d",
      "text": "#f2f2f2",
      "strongText": "#ffffff",
      "mutedText": "#9a9a9a",
