{
  // ===== 窗口 =====
  // 初始与最小尺寸（逻辑像素）。首次启动或没有记忆几何时使用默认尺寸。
  "window": {
    "defaultWidth": 920,
    "defaultHeight": 640,
    "minimumWidth": 500,
    "minimumHeight": 320
  },

  // ===== 通用布局令牌 =====
  // 被查找面板、历史面板、设置页与命令面板等复用的尺寸与间距。
  "layout": {
    "margin": 18,
    "resizeMargin": 8,
    "dragZoneHeight": 52,
    "borderWidth": 1,
    "spacingInput": 9,
    "spacingTight": 2,
    "spacingSmall": 4,
    "spacingNormal": 5,
    "spacingMedium": 8,
    "spacingLarge": 10,
    "spacingWide": 12,
    "spacingHuge": 20,
    "radiusSmall": 3,
    "radiusNormal": 4,
    "radiusMedium": 5,
    "radiusLarge": 6,
    "radiusXLarge": 7,
    "radiusPill": 17,
    "controlHeightCompact": 30,
    "controlHeightSmall": 32,
    "controlHeightNormal": 34,
    "controlHeightLarge": 36,
    "controlHeightTall": 38,
    "controlHeightExtraTall": 40,
    "editorPaddingX": 12,
    "editorPaddingY": 8,
    "headingFoldGutterWidth": 16,
    "headingFoldIconSize": 16,
    "editorContentBottomGap": 20,
    "selectionCursorWidth": 2,
    "scrollbarWidth": 5,
    "scrollbarMinHeight": 28,
    "scrollbarOffset": 2
  },

  // ===== 字体角色（pt）=====
  // editorDefaultSize 是 settings.ini 中编辑字号设置的默认值来源；
  // 状态面板字号默认值见 panels.statusPanel.defaultFontSize。
  "fonts": {
    "family": "Microsoft YaHei UI",
    "monospaceFamily": "Cascadia Mono",
    "title": 13,
    "heading": 11,
    "dialogTitle": 12,
    "normal": 10,
    "small": 9,
    "caption": 8,
    "editorDefaultSize": 13,
    "editorSizeMin": 9,
    "editorSizeMax": 24
  },

  // ===== 动画与交互延迟（毫秒）=====
  "animation": {
    "transitionDuration": 120,
    "windowShapeScale": 0.98,
    "historyHoverOpenDelay": 100,
    "historyHoverCloseDelay": 250,
    "scrollRefreshInterval": 60,
    "benchmarkDuration": 1000,
    "probeWidth": 40,
    "probeHeight": 2,
    "probeRadius": 1,
    "probeYOffset": 4
  },

  // ===== 面板尺寸与布局 =====
  "panels": {
    "statusText": {
      "maxWidth": 360,
      "maxWidthRatio": 0.55
    },
    "statusPanel": {
      "padding": 20,
      "margins": 10,
      "spacing": 5,
      "topGap": 6,
      "bottomGap": 12,
      "defaultFontSize": 10,
