      "widthInset": 48,
      "heightSingle": 66,
      "heightReplace": 104,
      "paddingX": 12,
      "paddingY": 10,
      "rowGap": 10,
      "controlsWidth": 328,
      "caseSensitiveWidth": 42,
      "prevWidth": 54,
      "nextWidth": 54,
      "closeWidth": 30,
      "actionWidth": 70,
      "rightInset": 42,
