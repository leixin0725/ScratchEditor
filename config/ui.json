      "defaultHideDelayMs": 250,
      "hideDelayMinMs": 0,
      "hideDelayMaxMs": 3000,
      "defaultMaxWidth": 360,
      "maxWidthMin": 200,
      "maxWidthMax": 800
    },
    "find": {
