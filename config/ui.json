  // ===== 窗口摆放 =====
  "placement": {
    "anchorGap": 16
  },

  // ===== 用户偏好默认值 =====
  // settings.ini 未覆盖时生效；主题/动画开关可继续在设置页修改。
  "preferences": {
    "theme": "dark",
    "animationsEnabled": true
  }
}
